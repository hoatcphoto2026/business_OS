{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Executive Overview – Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(increase(admin_http_requests_total[24h]))", "refId": "A" }]
    },
    {
      "title": "403 Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "admin_denied_ratio", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.2 }] } } }
    },
    {
      "title": "Alerts Fired",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "admin_403_alerts_total", "refId": "A" }]
    },
    {
      "title": "Request Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (status) (rate(admin_http_requests_total[5m]))", "refId": "A", "legendFormat": "{{status}}" }]
    },
    {
      "title": "API Key Creations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "increase(apikey_created_total[1h])", "refId": "A" }]
    },
    {
      "title": "Webhook Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "increase(webhook_delivery_errors_total[10m])", "refId": "A" }]
    },
    {
      "title": "Security Alerts",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "ALERTS{alertname=~\"Administration.*|ApiKey.*|Webhook.*\"}", "refId": "A", "format": "table" }]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
