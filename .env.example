# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=business_os
DB_LOGGING=false

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# Webhook secrets – REQUIRED in production (>= 32 chars, main.ts refuses to boot otherwise)
BANKING_WEBHOOK_SECRET=change-this-to-a-32-char-min-banking-secret
PAYMENT_WEBHOOK_SECRET=change-this-to-a-32-char-min-payment-secret

# App
PORT=3000
NODE_ENV=development

# HTTP / proxy / CORS
# Comma-separated list; in production CORS is disabled when unset.
CORS_ORIGIN=http://localhost:3000
# Set to the number of trusted proxy hops (e.g. 1 behind nginx/ALB) to make
# rate limiting use the real client IP. Leave empty when not behind a proxy.
TRUST_PROXY=

# Rate limiting (global, per client IP per window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# Admin mutation limit (per admin user / 60s window)
ADMIN_MUTATE_LIMIT=30
# Executive metrics (D1) – operator allowlist (comma separated).
# Empty in production = executive endpoints disabled (fail-closed).
# In dev/test, unset falls back to admin@abctrading.vn.
PLATFORM_ADMIN_EMAILS=admin@abctrading.vn
# Max request body size (json / urlencoded)
BODY_LIMIT=1mb

# Feature / danger switches (keep false/off in production)
ALLOW_TENANT_CREATE=false
SKIP_STEP_UP=false
RETENTION_PURGE_ENABLED=false
ALLOW_MOCK_PAYMENTS=true

# Payments – PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_SANDBOX=true

# Payments – VietQR (bank transfer)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=business-os-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# AI / Copilot (Sprint 10)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
